# RNV publishing agent — environment template
#
# Copy to .env and edit, then load it in each new shell:
#
#     cp .env.example .env      # .env is gitignored; never commit real values
#     set -a; source .env; set +a
#
# Or export these from ~/.bashrc so a new shell starts ready.
#
# server.py falls back to the Codespace paths below when a variable is unset.
# Off a Codespace those paths do not exist, and the failure arrives late wearing
# the wrong face: an unset BLOG_REPO makes validate_post report "no index.html"
# about a post that is sitting right there. Set them explicitly, then run
# `python tools/preflight.py` to confirm before you publish.

# Path to the site checkout. Must be the repo ROOT (the folder containing blog/).
# Windows: use C:/Users/... form. Native Python cannot resolve Git Bash's /c/Users/...
# Codespace fallback: /workspaces/rnvizion.github.io
BLOG_REPO="C:/Users/<you>/rnv/rnvizion.github.io"

# Path to the corpus checkout. Only stage 5 (update_corpus) reads it, so a wrong
# value fails at the very end of an otherwise successful publish.
# Codespace fallback: /workspaces/rnv-ask-the-corpus
CORPUS_REPO="C:/Users/<you>/rnv/rnv-ask-the-corpus"

# Live origin wait_for_live polls. No trailing slash.
# Codespace fallback: https://rnvizion.dev
SITE_URL="https://rnvizion.dev"

# ONLY needed for agent.py, the conversational route. The tools, the demo, and
# the test suite all run without it. Leave unset if you use the direct route.
# ANTHROPIC_API_KEY="sk-ant-..."
